# Environment Variables for Pakistan Halal Investment Platform

# Development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Pakistan Halal Investment Platform

# Payment Gateway (Add your credentials)
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_API_KEY=your_api_key
EASYPAISA_MERCHANT_ID=your_merchant_id
EASYPAISA_API_KEY=your_api_key

# Database (if needed)
DATABASE_URL=your_database_url

# Authentication
JWT_SECRET=your_secret_key

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_CONTROL=true
NEXT_PUBLIC_ENABLE_PORTFOLIO=false
NEXT_PUBLIC_ENABLE_HALAL_SCREENING=true

# Notes:
# - Copy this file to .env.local for local development
# - Never commit .env.local to Git
# - .env.local is already in .gitignore
# - For production, set environment variables in your hosting platform
